# Backend URL the app talks to.
# - For local dev with `expo start`, use your machine's LAN IP or an ngrok/tunnel URL,
#   e.g. EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:8001
# - For an EAS build (APK) that must work off your dev machine, point this at a backend
#   you've actually deployed (Railway, Render, Fly.io, etc.) - the old
#   *.preview.emergentagent.com tunnel URL from the original export is dead and MUST be
#   replaced before building, or every screen will fail to load data (with an honest
#   error/sample-data fallback rather than a crash).
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
